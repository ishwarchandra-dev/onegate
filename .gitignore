# Go
# root build output only — anchored (/bin/) so launcher/bin/ (the npm
# launcher entry, p9.npx-launcher) stays tracked
/bin/
dist/
*.exe
*.test
*.out
coverage.*

# Node
node_modules/
# npm launcher (p9.npx-launcher): pack output never lands in git
launcher/*.tgz
# Dashboard build output — everything except the committed placeholder
# (web/build/client/index.html), which keeps `go build ./...` working on
# fresh clones without a Node toolchain (p9.embed-pipeline, ADR 006).
web/build/*
!web/build/client
web/build/client/*
!web/build/client/index.html
web/.react-router/

# OneGate runtime state
.onegate/
*.db
*.db-shm
*.db-wal

# IDE / OS
.idea/
.vscode/
.DS_Store
*.swp
